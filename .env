# Combined RAG Configuration

# OpenAI
OPENAI_API_KEY=st.secrets.get(OPENAI_API_KEY) or os.getenv(OPENAI_API_KEY)
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j (Graph RAG)
NEO4J_URI=neo4j+s://dae65b6c.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=st.secrets.get(NEO4J_PASSWORD) or os.getenv(NEO4J_PASSWORD)


# ChromaDB (Traditional RAG)
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=risk_rag_chunks
TOP_K=6
